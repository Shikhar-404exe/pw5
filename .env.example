# Mira environment configuration
# Copy this file to `.env` and fill in your own values. Never commit real keys.

# --- AI provider (optional) ---
# Any OpenAI-compatible chat-completions endpoint (OpenAI, Groq, OpenRouter, ...).
# Leave EMPTY to run Mira in built-in demo mode: all planning features work offline
# with a deterministic local planner and clearly-labelled demonstration data.
MIRA_AI_BASE_URL=https://api.openai.com/v1
MIRA_AI_API_KEY=
MIRA_AI_MODEL=gpt-4o-mini

# --- Server ---
# Port for the small backend that serves the app and proxies AI requests,
# keeping your API key out of the browser bundle.
PORT=8787

# --- Vendor discovery (optional, NOT configured in this build) ---
# No vendor search provider credentials exist for this project. The app therefore
# shows clearly-labelled SAMPLE vendors for demonstration only. If you later add a
# provider, document its variable name here and implement it in server/index.mjs.
MIRA_VENDOR_PROVIDER=
